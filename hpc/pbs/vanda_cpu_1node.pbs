#!/bin/bash
# Vanda, one full CPU node (72 cores, nothing else on it): E1 serial scaling and the T1
# baselines of every speedup, E3 strong scaling p = 2..72, E4 weak scaling p = 1..72,
# E5 communication variants at p = 64, E6 MPI x OpenMP sweep on one node.
# The baselines run here rather than in a 1-core job: a 1-core job shares its node with other
# jobs, whose memory traffic slows this memory-bound solver (3x on Atlas's serial queue).
# Submit from ~/dsa5208-p3 on Vanda:   qsub hpc/pbs/vanda_cpu_1node.pbs
# Output: results/cpu_vanda.csv.  Cost: 72 cores x <= 2.5 h = <= 180 CPU-h (about 1.3 h expected).
#PBS -N cg_cpu_1node
#PBS -l select=1:ncpus=72:mpiprocs=72:mem=480gb
#PBS -l walltime=02:30:00
#PBS -j oe

cd "$PBS_O_WORKDIR"
source hpc/pbs/env_vanda.sh
JOB=${PBS_JOBID%%.*}
mkdir -p hpc/env results
exec > "hpc/env/cpu_vanda_1node_$JOB.txt" 2>&1
B="build/vanda-$JOB"
hostname; lscpu | grep -E "^(Model name|CPU\(s\)|Socket|NUMA node|L3)"
make -j16 BUILD="$B" serial mpi
B="$B" CSV=results/cpu_vanda.csv NODES=1 CORES=72 P_STRONG="2 4 8 16 32 64 72" \
  WHAT="serial strong weak comm hybrid placement" bash hpc/pbs/cpu_sweep.sh
